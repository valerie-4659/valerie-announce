# One-off, from the X developer portal (the app that already exists for
# Crosspost Helper works — a developer app can post on behalf of any account
# that authorises it, so @valeries_apps needs no new developer signup).
X_API_KEY=
X_API_SECRET=

# From `npm run authorize`, which runs the three-legged PIN flow and prints
# them. Static: OAuth 1.0a tokens do not expire, which is the whole reason a
# bot uses them instead of the app's OAuth 2.0 refresh tokens.
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Optional. Only lifts the GitHub rate limit for the release lookups; every
# repo the announcer reads is public.
GITHUB_TOKEN=
